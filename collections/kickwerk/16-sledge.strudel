// Album: Kickwerk
// Track: 16 — sledge
// Genre: Heavy techno / hard kick studies
// Tempo / CPM: 177 BPM (setcpm 44.25)
// Bass concept: A1 sub doubled — one voice locked to every kick, a second, louder voice only on the
//   downbeat, so beat 1 hits harder than 2, 3 and 4 without changing the kick pattern itself.
// Kick character: the album's peak — shape and distort both maxed, plus a second, even more distorted
//   kick voice stacked only on beat 1 for a genuine two-kick sledgehammer strike.
// Musical idea: The heaviest track on the record. Everything built toward this: two kicks stacked on
//   the downbeat, distortion at the ceiling, and the biggest breakdown on the album every 8 bars.
// Strudel focus: two s("bd") layers at different struct positions; .every(8, x => x.degradeBy(0.6)).
// Visualisation: ._punchcard({ cycles: 2, flipTime: true }) — the stacked downbeat reads as a spike.

setcpm(44.25)

stack(

  // ── KICK — four on the floor, maxed ──────────────────────────────
  s("bd*4")
    .shape(0.65).distort(1.4).lpf(175)
    .gain(0.95)
    .every(8, x => x.degradeBy(0.6))
    .color("crimson")
    ._punchcard({ cycles: 2, flipTime: true }),

  // ── SLEDGE — a second, harder kick stacked on beat 1 only ─────────
  s("bd ~ ~ ~")
    .shape(0.75).distort(1.4).lpf(150)
    .gain(0.9)
    .color("darkred"),

  // ── SUB — doubled the same way as the kick ────────────────────────
  note("a1*4")
    .sound("sine").attack(0.001).release(0.12).shape(0.18)
    .gain(0.6)
    .color("navy"),

  note("a1 ~ ~ ~")
    .sound("sine").attack(0.001).release(0.22).shape(0.22)
    .gain(0.3)
    .color("navy"),

  // ── HATS ───────────────────────────────────────────────────────
  s("hh*16").gain(0.2).hpf(7500)
    .color("yellow"),

  // ── CLAP on 2 + 4 ─────────────────────────────────────────────────
  s("~ cp ~ cp").gain(0.5).hpf(430).room(0.16)
    .color("coral")
)
