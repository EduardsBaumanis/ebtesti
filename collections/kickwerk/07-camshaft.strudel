// Album: Kickwerk
// Track: 07 — camshaft
// Genre: Heavy techno / hard kick studies
// Tempo / CPM: 161 BPM (setcpm 40.25)
// Bass concept: A1 sub locked to the kick's straight *4 — the shaft's steady rotation underneath.
// Kick character: hard shape, tighter lpf than Ignition — the constant the valves click against.
// Musical idea: A camshaft opens and closes valves at precise offsets from the main rotation. The kick
//   stays a plain four-on-the-floor; a rimshot "valve click" rides euclid(5,8) — five clicks per eight
//   steps, never lining up the same way against the four kicks twice in a row.
// Strudel focus: s("rim").euclid(5,8) against a static kick — a second, unrelated euclidean grid.
// Visualisation: ._punchcard({ cycles: 4 }) — long enough to see the 5-against-4 drift and reset.

setcpm(40.25)

stack(

  // ── KICK — the shaft's steady rotation ───────────────────────────
  s("bd*4")
    .shape(0.52).distort(1.15).lpf(185)
    .gain(0.9)
    .color("red")
    ._punchcard({ cycles: 4 }),

  // ── SUB — locked body ─────────────────────────────────────────────
  note("a1*4")
    .sound("sine").attack(0.001).release(0.13).shape(0.1)
    .gain(0.56)
    .color("navy"),

  // ── VALVE CLICK — euclid(5,8) rimshot ─────────────────────────────
  s("rim").euclid(5, 8)
    .gain(0.32).hpf(2000).room(0.2)
    .color("silver"),

  // ── HATS ───────────────────────────────────────────────────────
  s("hh*8").gain(0.2).hpf(7400)
    .color("yellow")
)
