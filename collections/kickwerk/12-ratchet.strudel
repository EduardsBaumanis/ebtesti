// Album: Kickwerk
// Track: 12 — ratchet
// Genre: Heavy techno / hard kick studies
// Tempo / CPM: 170 BPM (setcpm 42.5)
// Bass concept: A1 sub locked to the kick — it doesn't ratchet, it just holds the load steady.
// Kick character: base distortion is already hot; one quarter of every cycle clicks up harder still.
// Musical idea: A ratchet only moves one direction, one notch at a time. The kick's distortion sits at
//   a fixed level except for a single quarter of the bar, which cranks it up one extra notch — and
//   which quarter that is rotates cycle to cycle, so the "click" walks around the loop.
// Strudel focus: base .distort(1.1) then .chunk(4, x => x.distort(1.6)) — chunk only overrides its slice.
// Visualisation: ._punchcard({ cycles: 4, labels: true }) — four cycles show the click move around.

setcpm(42.5)

stack(

  // ── KICK — one notch tighter, one quarter at a time ──────────────
  s("bd*4")
    .shape(0.55).distort(1.1).lpf(190).gain(0.9)
    .chunk(4, x => x.distort(1.6))
    .color("red")
    ._punchcard({ cycles: 4, labels: true }),

  // ── SUB — holds steady ─────────────────────────────────────────────
  note("a1*4")
    .sound("sine").attack(0.001).release(0.14).shape(0.1)
    .gain(0.56)
    .color("navy"),

  // ── HATS ───────────────────────────────────────────────────────
  s("hh*8").gain(0.2).hpf(7300)
    .color("yellow"),

  // ── CLAP on 2 + 4 ─────────────────────────────────────────────────
  s("~ cp ~ cp").gain(0.46).hpf(420).room(0.18)
    .color("coral")
)
