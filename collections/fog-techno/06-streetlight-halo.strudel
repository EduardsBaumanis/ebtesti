// ══════════════════════════════════════════════════════════════
// "Streetlight Halo"
// Track 6 of 24 · Fog Techno
//
// Key:    E Aeolian
// Tempo:  123 BPM  (setcpm 30.75)
// Mood:   Sodium-orange rings bloom around every lamp on the wet street.
//
// SLIDER MAP
//   pad.phaser + pad.phaserdepth are the halo — sweep them for the ring to breathe.
//   Every gain / filter / envelope / space / time knob below is a
//   slider(default, min, max) — drag any of them mid-playback. Several
//   default to 0 or "off" on purpose so the control exists even where
//   the track doesn't use it yet.
// ══════════════════════════════════════════════════════════════

setcpm(slider(30.75, 25.75, 36.75))

stack(

  // ── KICK — wet-street thud ────────────────────────────────────
  s("bd ~ bd ~  bd ~ bd ~")
    .gain(slider(0.73, 0, 1.1)).pan(slider(0.5, 0, 1)).lpf(slider(180, 60, 4000))
    .lpq(slider(6, 0, 20)).hpf(slider(20, 20, 800)).shape(slider(0.25, 0, 1))
    .crush(slider(16, 1, 16)).room(slider(0, 0, 1)).size(slider(0.2, 0, 1))
    .delay(slider(0, 0, 0.9)).delaytime(slider(0.375, 0.06, 1.5)).delayfeedback(slider(0.15, 0, 0.9))
    .attack(slider(0.001, 0, 0.3)).decay(slider(0.1, 0, 1)).sustain(slider(0, 0, 1))
    .release(slider(0.15, 0, 2)).speed(slider(1, 0.5, 2))
    .color("dimgray"),

  // ── SUB — low glow ────────────────────────────────────────────
  note("e1 ~ ~ ~  ~ ~ ~ ~").sound("sine")
    .gain(slider(0.62, 0, 1)).pan(slider(0.5, 0, 1)).lpf(slider(600, 100, 3000))
    .lpq(slider(3, 0, 20)).hpf(slider(20, 20, 300)).shape(slider(0.05, 0, 1))
    .crush(slider(16, 1, 16)).room(slider(0.1, 0, 1)).size(slider(0.3, 0, 1))
    .delay(slider(0, 0, 0.9)).delaytime(slider(0.5, 0.06, 1.5)).delayfeedback(slider(0.15, 0, 0.9))
    .attack(slider(0.08, 0, 2)).decay(slider(0.2, 0, 1)).sustain(slider(0.6, 0, 1))
    .release(slider(0.4, 0, 3)).speed(slider(1, 0.5, 2))
    .color("midnightblue"),

  // ── BASS — walking under the lamps ────────────────────────────
  note("e2 ~ e2 ~  b2 ~ b2 ~  c3 ~ c3 ~  a2 ~ a2 ~").sound("sawtooth")
    .gain(slider(0.43, 0, 1)).pan(slider(0.5, 0, 1)).lpf(slider(800, 150, 3800))
    .lpq(slider(9, 0, 20)).hpf(slider(30, 20, 800)).shape(slider(0.2, 0, 1))
    .crush(slider(16, 1, 16)).room(slider(0.08, 0, 1)).size(slider(0.3, 0, 1))
    .delay(slider(0, 0, 0.9)).delaytime(slider(0.375, 0.06, 1.5)).delayfeedback(slider(0.2, 0, 0.9))
    .attack(slider(0.005, 0, 0.5)).decay(slider(0.15, 0, 1)).sustain(slider(0.3, 0, 1))
    .release(slider(0.2, 0, 2)).speed(slider(1, 0.5, 2)).distort(slider(0, 0, 1.4))
    .color("steelblue"),

  // ── HATS — fine drizzle ───────────────────────────────────────
  s("hh*16")
    .gain(slider(0.2, 0, 0.6)).pan(slider(0.5, 0, 1)).lpf(slider(8000, 2000, 12000))
    .lpq(slider(2, 0, 20)).hpf(slider(6000, 2000, 12000)).shape(slider(0, 0, 1))
    .crush(slider(16, 1, 16)).room(slider(0.15, 0, 1)).size(slider(0.2, 0, 1))
    .delay(slider(0, 0, 0.9)).delaytime(slider(0.125, 0.06, 1.5)).delayfeedback(slider(0.1, 0, 0.9))
    .attack(slider(0.001, 0, 0.2)).decay(slider(0.03, 0, 1)).sustain(slider(0, 0, 1))
    .release(slider(0.04, 0, 1)).speed(slider(1, 0.5, 2))
    .color("silver"),

  // ── CLAP — puddle splash on 2 and 4 ───────────────────────────
  s("~ cp ~ cp")
    .gain(slider(0.42, 0, 1)).pan(slider(0.5, 0, 1)).lpf(slider(4000, 300, 10000))
    .lpq(slider(3, 0, 20)).hpf(slider(400, 20, 4000)).shape(slider(0.1, 0, 1))
    .crush(slider(16, 1, 16)).room(slider(0.3, 0, 1)).size(slider(0.35, 0, 1))
    .delay(slider(0, 0, 0.9)).delaytime(slider(0.25, 0.06, 1.5)).delayfeedback(slider(0.15, 0, 0.9))
    .attack(slider(0.001, 0, 0.2)).decay(slider(0.08, 0, 1)).sustain(slider(0, 0, 1))
    .release(slider(0.12, 0, 2)).speed(slider(1, 0.5, 2))
    .color("lightslategray"),

  // ── PAD — halo chords, phaser breathing ───────────────────────
  note("<[e3,g3,b3] [b3,d4,fs4] [c4,e4,g4] [a3,c4,e4]>").sound("sawtooth").vowel("<o a>")
    .gain(slider(0.3, 0, 0.7)).pan(slider(0.5, 0, 1)).lpf(slider(1400, 200, 6000))
    .lpq(slider(3, 0, 20)).hpf(slider(60, 20, 2000)).shape(slider(0, 0, 1))
    .crush(slider(16, 1, 16)).room(slider(0.45, 0, 1)).size(slider(0.7, 0, 1))
    .delay(slider(0.1, 0, 0.9)).delaytime(slider(0.5, 0.06, 1.5)).delayfeedback(slider(0.25, 0, 0.9))
    .attack(slider(1.2, 0, 8)).decay(slider(0.8, 0, 4)).sustain(slider(0.7, 0, 1))
    .release(slider(2, 0, 10)).speed(slider(1, 0.5, 2)).phaser(slider(0.35, 0, 8))
    .phaserdepth(slider(0.45, 0, 1))
    .color("slategray"),

  // ── LEAD — sodium flicker ─────────────────────────────────────
  note("e4 a4 g4 b4 a4 c5 b4 g4")
    .sound("square")
    .gain(slider(0.24, 0, 0.7)).pan(slider(0.5, 0, 1)).lpf(slider(2200, 300, 8000))
    .lpq(slider(6, 0, 20)).hpf(slider(150, 20, 2000)).shape(slider(0.1, 0, 1))
    .crush(slider(11, 1, 16)).room(slider(0.3, 0, 1)).size(slider(0.5, 0, 1))
    .delay(slider(0.25, 0, 0.9)).delaytime(slider(0.3, 0.06, 1.5)).delayfeedback(slider(0.35, 0, 0.9))
    .attack(slider(0.004, 0, 0.5)).decay(slider(0.1, 0, 1)).sustain(slider(0.2, 0, 1))
    .release(slider(0.18, 0, 2)).speed(slider(1, 0.5, 2)).vib(slider(0, 0, 8))
    .vibmod(slider(0, 0, 0.6))
    .color("powderblue")
)
