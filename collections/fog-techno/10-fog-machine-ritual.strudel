// ══════════════════════════════════════════════════════════════
// "Fog Machine Ritual"
// Track 10 of 24 · Fog Techno
//
// Key:    A Phrygian
// Tempo:  132 BPM  (setcpm 33)
// Mood:   The club's own fog machine takes over — dry ice under strobing peak-time lights.
//
// SLIDER MAP
//   bass.lpf + bass.lpq are the acid line; push both up together for the classic 303 scream.
//   Every gain / filter / envelope / space / time knob below is a
//   slider(default, min, max) — drag any of them mid-playback. Several
//   default to 0 or "off" on purpose so the control exists even where
//   the track doesn't use it yet.
// ══════════════════════════════════════════════════════════════

setcpm(slider(33, 28, 39))

stack(

  // ── KICK — peak-time, full weight ─────────────────────────────
  s("bd*4")
    .gain(slider(0.88, 0, 1.1)).pan(slider(0.5, 0, 1)).lpf(slider(180, 60, 4000))
    .lpq(slider(6, 0, 20)).hpf(slider(20, 20, 800)).shape(slider(0.4, 0, 1))
    .crush(slider(16, 1, 16)).room(slider(0, 0, 1)).size(slider(0.2, 0, 1))
    .delay(slider(0, 0, 0.9)).delaytime(slider(0.375, 0.06, 1.5)).delayfeedback(slider(0.15, 0, 0.9))
    .attack(slider(0.001, 0, 0.3)).decay(slider(0.1, 0, 1)).sustain(slider(0, 0, 1))
    .release(slider(0.15, 0, 2)).speed(slider(1, 0.5, 2))
    .color("dimgray"),

  // ── SUB — club-floor pressure ─────────────────────────────────
  note("a1*2").sound("sine")
    .gain(slider(0.75, 0, 1)).pan(slider(0.5, 0, 1)).lpf(slider(600, 100, 3000))
    .lpq(slider(3, 0, 20)).hpf(slider(20, 20, 300)).shape(slider(0.05, 0, 1))
    .crush(slider(16, 1, 16)).room(slider(0.1, 0, 1)).size(slider(0.3, 0, 1))
    .delay(slider(0, 0, 0.9)).delaytime(slider(0.5, 0.06, 1.5)).delayfeedback(slider(0.15, 0, 0.9))
    .attack(slider(0.08, 0, 2)).decay(slider(0.2, 0, 1)).sustain(slider(0.6, 0, 1))
    .release(slider(0.4, 0, 3)).speed(slider(1, 0.5, 2))
    .color("midnightblue"),

  // ── ACID — 303-style line, resonance wide open ────────────────
  note("a2 ~ bb2 ~ g3 ~ d3 ~  a2 ~ g3 ~ e3 ~ ~ ~")
    .sound("sawtooth")
    .gain(slider(0.5, 0, 1)).pan(slider(0.5, 0, 1)).lpf(slider(900, 200, 4500))
    .lpq(slider(14, 0, 20)).hpf(slider(30, 20, 800)).shape(slider(0.2, 0, 1))
    .crush(slider(16, 1, 16)).room(slider(0.08, 0, 1)).size(slider(0.3, 0, 1))
    .delay(slider(0, 0, 0.9)).delaytime(slider(0.375, 0.06, 1.5)).delayfeedback(slider(0.2, 0, 0.9))
    .attack(slider(0.005, 0, 0.5)).decay(slider(0.15, 0, 1)).sustain(slider(0.3, 0, 1))
    .release(slider(0.2, 0, 2)).speed(slider(1, 0.5, 2)).distort(slider(0.3, 0, 1.4))
    .color("steelblue"),

  // ── HATS — relentless sixteenths ──────────────────────────────
  s("hh*16")
    .gain(slider(0.28, 0, 0.7)).pan(slider(0.5, 0, 1)).lpf(slider(8000, 2000, 12000))
    .lpq(slider(2, 0, 20)).hpf(slider(6000, 2000, 12000)).shape(slider(0, 0, 1))
    .crush(slider(16, 1, 16)).room(slider(0.15, 0, 1)).size(slider(0.2, 0, 1))
    .delay(slider(0, 0, 0.9)).delaytime(slider(0.125, 0.06, 1.5)).delayfeedback(slider(0.1, 0, 0.9))
    .attack(slider(0.001, 0, 0.2)).decay(slider(0.03, 0, 1)).sustain(slider(0, 0, 1))
    .release(slider(0.04, 0, 1)).speed(slider(1, 0.5, 2))
    .color("silver"),

  // ── CLAP — the whole room on 2 and 4 ──────────────────────────
  s("~ cp ~ cp")
    .gain(slider(0.55, 0, 1.1)).pan(slider(0.5, 0, 1)).lpf(slider(4000, 300, 10000))
    .lpq(slider(3, 0, 20)).hpf(slider(400, 20, 4000)).shape(slider(0.1, 0, 1))
    .crush(slider(16, 1, 16)).room(slider(0.25, 0, 1)).size(slider(0.35, 0, 1))
    .delay(slider(0, 0, 0.9)).delaytime(slider(0.25, 0.06, 1.5)).delayfeedback(slider(0.15, 0, 0.9))
    .attack(slider(0.001, 0, 0.2)).decay(slider(0.08, 0, 1)).sustain(slider(0, 0, 1))
    .release(slider(0.12, 0, 2)).speed(slider(1, 0.5, 2))
    .color("lightslategray"),

  // ── FOG — literal dry-ice machine under the lights ────────────
  s("white")
    .gain(slider(0.2, 0, 0.6)).pan(slider(0.5, 0, 1)).lpf(slider(600, 80, 12000))
    .lpq(slider(2, 0, 20)).hpf(slider(80, 20, 4000)).shape(slider(0, 0, 1))
    .crush(slider(16, 1, 16)).room(slider(0.4, 0, 1)).size(slider(0.6, 0, 1))
    .delay(slider(0, 0, 0.9)).delaytime(slider(0.5, 0.06, 1.5)).delayfeedback(slider(0.2, 0, 0.9))
    .attack(slider(2, 0, 8)).decay(slider(1, 0, 4)).sustain(slider(0.7, 0, 1))
    .release(slider(2, 0, 8)).speed(slider(1, 0.25, 2)).phaser(slider(0, 0, 8))
    .phaserdepth(slider(0, 0, 1))
    .color("gainsboro"),

  // ── PAD — stabs between the smoke ─────────────────────────────
  note("<[a3,c4,e4] [d4,f4,a4] [g4,bb4,d5] [c4,e4,g4]>*2").sound("sawtooth").vowel("a")
    .gain(slider(0.26, 0, 0.7)).pan(slider(0.5, 0, 1)).lpf(slider(1400, 200, 6000))
    .lpq(slider(3, 0, 20)).hpf(slider(60, 20, 2000)).shape(slider(0, 0, 1))
    .crush(slider(16, 1, 16)).room(slider(0.45, 0, 1)).size(slider(0.7, 0, 1))
    .delay(slider(0.1, 0, 0.9)).delaytime(slider(0.5, 0.06, 1.5)).delayfeedback(slider(0.25, 0, 0.9))
    .attack(slider(0.02, 0, 2)).decay(slider(0.8, 0, 4)).sustain(slider(0.7, 0, 1))
    .release(slider(0.3, 0, 4)).speed(slider(1, 0.5, 2)).phaser(slider(0.2, 0, 8))
    .phaserdepth(slider(0.35, 0, 1))
    .color("slategray")
)
